{
  "name": "@metamask/eth-json-rpc-filters",
  "version": "9.0.0",
  "description": "[json-rpc-engine](https://github.com/MetaMask/json-rpc-engine) middleware implementing ethereum filter methods. Backed by an [eth-block-tracker](https://github.com/MetaMask/eth-block-tracker) and web3 provider interface (`web3.currentProvider`).",
  "main": "index.js",
  "engines": {
    "node": "^22.14.0 || ^24 || ^26"
  },
  "scripts": {
    "build": "echo 'this does nothing'",
    "build:clean": "rimraf dist && yarn build",
    "lint": "printf '%s\\n' 'No lint command'",
    "setup": "yarn install",
    "test": "vitest",
    "test:clean": "vitest --clearCache",
    "test:coverage": "vitest --coverage",
    "test:verbose": "vitest --reporter=verbose",
    "test:watch": "vitest --watch"
  },
  "license": "ISC",
  "files": [
    "*.js"
  ],
  "dependencies": {
    "@metamask/eth-query": "^4.0.0",
    "@metamask/json-rpc-engine": "^11.0.0",
    "@metamask/safe-event-emitter": "^3.1.3",
    "async-mutex": "^0.5.0",
    "pify": "^5.0.0"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@metamask/auto-changelog": "^7.1.0",
    "@metamask/eth-block-tracker": "^16.0.0",
    "@metamask/eth-json-rpc-middleware": "^26.0.0",
    "@metamask/eth-json-rpc-provider": "^7.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "ganache": "^7.9.2",
    "vite": "^8.0.8",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/eth-json-rpc-filters.git"
  },
  "bugs": {
    "url": "https://github.com/MetaMask/eth-json-rpc-filters/issues"
  },
  "homepage": "https://github.com/MetaMask/eth-json-rpc-filters#readme",
